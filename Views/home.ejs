<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Members Only</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Welcome to Members Only!</h1>
    <h2>Share your experience, feelings, or even secrets~.</h2>
    <nav>
        <a href="/">Home</a>
        <% if (user) { %>
            <a href="/logout">Logout</a>
            <form action="/createmsg" style="display: flex; align-items: center; gap: 10px;">
                <label for="message">Create New Message: </label>
                <input type="text" id="message" name="message">
                <button>Create</button>
            </form>
        <% } else { %>
            <a href="/sign-up">Sign Up</a>
            <a href="/login">Login</a>
        <% } %>
    </nav>

    <section>
        <h2>What do we have here?</h2>

        <div class="messages">
            <% rows.forEach(row => { %>
                <div class="card">
                    <% if (user) {%>
                        <div class="author"><%= row.username %></div>
                        <div class="date"><%= row.created_date.toLocaleDateString('en-GB') %></div>
                    <% }else{ %>
                        <div class="author">Anonymous</div>
                    <% } %>
                    <div class="message"><%= row.message %></div>
                </div> 
            <% }); %>
        </div>
        
    </section>
</body>
</html>